generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id           String   @id @default(uuid())
  email        String?  @unique
  passwordHash String?
  role         Role
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  admin        Admin?
  teacher      Teacher?

  @@map("users")
}

model Teacher {
  id               String            @id @default(uuid())
  userId           String            @unique
  madrasatiId      String            @unique
  nationalId       String            @unique
  teacherName      String
  mobile           String?
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  generatedLessons GeneratedLesson[]
  subscription     Subscription?
  user             User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  templates        Template[]
  usageLogs        UsageLog[]

  @@map("teachers")
}

model Admin {
  id                    String         @id @default(uuid())
  userId                String         @unique
  fullName              String
  email                 String         @unique
  mobile                String?
  permissions           String[]       @default([])
  createdAt             DateTime       @default(now())
  updatedAt             DateTime       @updatedAt
  user                  User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  uploadedSyllabusWeeks SyllabusWeek[]

  @@map("admins")
}

model Subscription {
  id        String    @id @default(uuid())
  plan      String
  active    Boolean   @default(true)
  startsAt  DateTime  @default(now())
  endsAt    DateTime?
  teacherId String?   @unique
  teacher   Teacher?  @relation(fields: [teacherId], references: [id])

  @@map("subscriptions")
}

model PromptTemplate {
  id               String            @id @default(uuid())
  name             String
  description      String
  version          Int               @default(1)
  content          String
  locale           String            @default("ar-SA")
  isPublished      Boolean           @default(false)
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  generatedLessons GeneratedLesson[]
  promptVersions   PromptVersion[]

  @@map("prompt_templates")
}

model PromptVersion {
  id         String         @id @default(uuid())
  templateId String
  version    Int
  changelog  String
  content    String
  createdAt  DateTime       @default(now())
  template   PromptTemplate @relation(fields: [templateId], references: [id])

  @@map("prompt_versions")
}

model Template {
  id          String   @id @default(uuid())
  name        String
  description String?
  ownerId     String
  payload     Json
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  owner       Teacher  @relation(fields: [ownerId], references: [id])

  @@map("templates")
}

model GeneratedLesson {
  id               String          @id @default(uuid())
  teacherId        String
  promptTemplateId String?
  lessonDate       DateTime
  subject          String
  grade            String
  section          String?
  output           Json
  status           LessonStatus    @default(PENDING)
  metadata         Json?
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt
  promptTemplate   PromptTemplate? @relation(fields: [promptTemplateId], references: [id])
  teacher          Teacher         @relation(fields: [teacherId], references: [id])

  @@map("generated_lessons")
}

model UsageLog {
  id        String   @id @default(uuid())
  teacherId String
  event     String
  details   Json?
  createdAt DateTime @default(now())
  teacher   Teacher  @relation(fields: [teacherId], references: [id])

  @@map("usage_logs")
}

model EducationStage {
  id     String  @id @default(uuid())
  name   String  @unique
  order  Int     @default(0)
  tracks Track[]

  @@map("education_stages")
}

model Track {
  id      String         @id @default(uuid())
  stageId String
  name    String
  order   Int            @default(0)
  grades  Grade[]
  stage   EducationStage @relation(fields: [stageId], references: [id], onDelete: Cascade)

  @@unique([stageId, name])
  @@map("tracks")
}

model Grade {
  id            String         @id @default(uuid())
  trackId       String
  name          String
  order         Int            @default(0)
  gradeSubjects GradeSubject[]
  track         Track          @relation(fields: [trackId], references: [id], onDelete: Cascade)
  semesters     Semester[]

  @@unique([trackId, name])
  @@map("grades")
}

model Semester {
  id                  String         @id @default(uuid())
  madrasatiSemesterId String?
  name                String
  order               Int            @default(0)
  gradeId             String
  gradeSubjects       GradeSubject[]
  grade               Grade          @relation(fields: [gradeId], references: [id], onDelete: Cascade)

  @@unique([gradeId, name])
  @@map("semesters")
}

model Subject {
  id            String         @id @default(uuid())
  name          String         @unique
  gradeSubjects GradeSubject[]

  @@map("subjects")
}

model GradeSubject {
  id            String           @id @default(uuid())
  gradeId       String
  semesterId    String
  subjectId     String
  createdAt     DateTime         @default(now())
  grade         Grade            @relation(fields: [gradeId], references: [id], onDelete: Cascade)
  semester      Semester         @relation(fields: [semesterId], references: [id], onDelete: Cascade)
  subject       Subject          @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  activities    LessonActivity[]
  syllabusWeeks SyllabusWeek[]

  @@unique([gradeId, semesterId, subjectId])
  @@map("grade_subjects")
}

model SyllabusWeek {
  id                 String          @id @default(uuid())
  gradeSubjectId     String
  weekNumber         Int
  region             Region          @default(GENERAL)
  startDateHijri     String?
  endDateHijri       String?
  startDateGregorian DateTime?
  endDateGregorian   DateTime?
  weekType           WeekType        @default(LESSON)
  title              String
  uploadedById       String
  createdAt          DateTime        @default(now())
  updatedAt          DateTime        @updatedAt
  activity           LessonActivity?
  gradeSubject       GradeSubject    @relation(fields: [gradeSubjectId], references: [id], onDelete: Cascade)
  uploadedBy         Admin           @relation(fields: [uploadedById], references: [id])
  weekDays           WeekDay[]

  @@unique([gradeSubjectId, weekNumber, region])
  @@map("syllabus_weeks")
}

model WeekDay {
  id          String       @id @default(uuid())
  weekId      String
  dayOfWeek   String
  type        WeekType     @default(LESSON)
  lessonTitle String?
  order       Int
  week        SyllabusWeek @relation(fields: [weekId], references: [id], onDelete: Cascade)

  @@map("week_days")
}

model CalendarDay {
  id        String   @id @default(uuid())
  date      DateTime
  dayName   String
  type      WeekType @default(LESSON)
  region    Region   @default(GENERAL)
  note      String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([date, region])
  @@map("calendar_days")
}

model AnalyticsEvent {
  id        String   @id @default(uuid())
  category  String
  action    String
  label     String?
  value     Int?     @default(0)
  metadata  Json?
  createdAt DateTime @default(now())

  @@map("analytics_events")
}

model ExtensionVersion {
  id         String   @id @default(uuid())
  version    String
  changelog  String?
  releasedAt DateTime @default(now())

  @@map("extension_versions")
}

model FeatureFlag {
  id          String  @id @default(uuid())
  key         String  @unique
  enabled     Boolean @default(false)
  description String?

  @@map("feature_flags")
}

model LessonActivity {
  id             String               @id @default(uuid())
  syllabusWeekId String?              @unique
  gradeSubjectId String
  lessonTitle    String
  createdAt      DateTime             @default(now())
  updatedAt      DateTime             @updatedAt
  gradeSubject   GradeSubject         @relation(fields: [gradeSubjectId], references: [id], onDelete: Cascade)
  syllabusWeek   SyllabusWeek?        @relation(fields: [syllabusWeekId], references: [id], onDelete: Cascade)
  items          LessonActivityItem[]

  @@map("lesson_activities")
}

model LessonActivityItem {
  id               String         @id @default(uuid())
  lessonActivityId String
  type             String
  title            String
  url              String?
  filePath         String?
  thumbnailUrl     String?
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt
  lessonActivity   LessonActivity @relation(fields: [lessonActivityId], references: [id], onDelete: Cascade)

  @@map("lesson_activity_items")
}

enum Role {
  TEACHER
  ADMIN
}

enum LessonStatus {
  PENDING
  COMPLETED
  FAILED
}

enum WeekType {
  LESSON
  HOLIDAY
  EXAM
}

enum Region {
  GENERAL
  MAKKAH
  JEDDAH
  TAIF
  WESTERN
}
